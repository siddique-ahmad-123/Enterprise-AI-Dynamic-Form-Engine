PORT=8000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
ENABLE_PHOENIX=true
PHOENIX_COLLECTOR_ENDPOINT=https://ainsg.newgensoftware.net/phoenix/v1/traces
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000,http://localhost:3000

# PostgreSQL Database & Persistence
DATABASE_URL=postgresql://admin:admin@postgres-db:5432/myapp?sslmode=prefer
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=myapp
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_SSLMODE=prefer
